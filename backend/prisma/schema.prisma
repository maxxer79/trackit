generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  name           String
  role           Role      @default(USER)
  trackingLimit  Int       @default(10)
  // Notification preferences
  emailAlerts    Boolean   @default(true)
  pushAlerts     Boolean   @default(true)
  browserAlerts  Boolean   @default(true)
  notifySms      Boolean   @default(false)
  notifyDiscord  Boolean   @default(false)
  notifyPriceDrop Boolean  @default(false)
  notifyLowStock  Boolean  @default(false)
  // Quiet hours: suppress external notification channels during this window.
  // Start/end are minutes-from-midnight (0..1439) in the user's timezone.
  quietHoursEnabled Boolean @default(false)
  quietHoursStart   Int?
  quietHoursEnd     Int?
  timezone          String?
  phoneNumber    String?
  discordWebhook String?
  autoBuyEnabled Boolean   @default(false)
  // In-store pickup alerts: one home ZIP used as the pickup location for all of
  // the user's tracked items, plus the master on/off switch for pickup alerts.
  pickupZip      String?
  notifyPickup   Boolean   @default(false)
  // Digest email cadence: "off" | "daily" | "weekly". Opt-in.
  digestFrequency String   @default("off")
  avatar         String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  trackings     Tracking[]
  alerts        Alert[]
  pushTokens    PushToken[]
  notifications Notification[]
  comments      Comment[]
  purchases     Purchase[]
  scraperReports ScraperReport[]

  @@map("users")
}

model ScraperReport {
  id                String   @id @default(cuid())
  userId            String
  productId         String?
  productName       String?
  storeSlug         String?
  storeName         String?
  productUrl        String?
  issueType         String   // WRONG_STOCK | WRONG_PRICE | NOT_LOADING | SELECTOR_BROKEN | OTHER
  description       String
  suggestedSelector String?
  status            String   @default("OPEN") // OPEN | REVIEWING | RESOLVED | DISMISSED
  adminNote         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@map("scraper_reports")
}

model Purchase {
  id             String    @id @default(cuid())
  userId         String
  productId      String
  productName    String
  productSlug    String?
  storeName      String?
  storeSlug      String?
  price          Decimal?
  purchasedAt    DateTime  @default(now())
  carrier          String?
  trackingNumber   String?
  status           String    @default("ORDERED")
  deliveredAt      DateTime?
  note             String?
  ship24TrackerId  String?
  deliveryMilestone String?  // raw Ship24 statusMilestone
  deliveryUpdatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, purchasedAt(sort: Desc)])
  @@map("purchases")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  imageUrl    String?
  category    String?
  description String?
  modelNumber String?
  tags        String[]
  isActive    Boolean  @default(true)
  isNew       Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeListings StoreProduct[]
  trackings     Tracking[]
  comments      Comment[]
  purchases     Purchase[]

  @@map("products")
}

model Store {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  logoUrl   String?
  domain    String?
  searchUrl String? // e.g. https://www.bestbuy.com/site/searchpage.jsp?st={query}
  country   String  @default("us")
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  products StoreProduct[]

  @@map("stores")
}

model StoreProduct {
  id          String    @id @default(cuid())
  productId   String
  storeId     String
  url         String
  price       Float?
  currency    String    @default("USD")
  inStock     Boolean   @default(false)
  stockStatus String?   // IN_STOCK | OUT_OF_STOCK | PREORDER | LIMITED | UNKNOWN
  condition   String    @default("NEW") // NEW | OPEN_BOX | USED | REFURBISHED
  stockLevel  Int?
  // In-store pickup signal a scraper may populate. null = unknown / not parsed
  // for this retailer; never used to flip online stockStatus.
  pickupAvailable Boolean?
  pickupLocation  String?
  // Lowest price ever observed for this listing (Price Target Watch).
  lowestPrice     Float?
  lowestPriceAt   DateTime?
  isActive    Boolean   @default(true)
  lastChecked DateTime?
  checkCount  Int       @default(0)
  failStreak  Int       @default(0) // consecutive UNKNOWN/error checks
  skipUntil   DateTime? // adaptive backoff: don't scrape again until this time
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Explicit Restrict (was Prisma's implicit default): a Store can't be deleted
  // while it still has listings — you must remove/relink the listings first.
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  alerts  Alert[]

  @@unique([productId, storeId])
  @@index([storeId])
  @@map("store_products")
}

model Tracking {
  id              String   @id @default(cuid())
  userId          String
  productId       String
  isActive        Boolean  @default(true)
  notifyEmail     Boolean  @default(true)
  notifyPush      Boolean  @default(true)
  watchStores     String[]
  note            String?
  tags            String[]
  alertMaxPrice   Decimal? // ceiling that GATES other alerts (don't ping above this)
  priceTarget     Decimal? // Price Target Watch: alert when price drops to/below this
  alertDays       Int[]
  mutedUntil      DateTime? // silent mode: suppress alerts until this time (tracking continues)
  archivedAt      DateTime? // hidden from the main dashboard; restorable
  autoBuyEnabled  Boolean  @default(false)
  autoBuyMaxPrice Decimal?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("trackings")
}

model Alert {
  id             String    @id @default(cuid())
  userId         String
  storeProductId String?
  productId      String?
  storeSlug      String?
  storeName      String?
  type           AlertType @default(IN_STOCK)
  status         String?
  price          Float?
  productUrl     String?
  emailSent      Boolean   @default(false)
  smsSent        Boolean   @default(false)
  pushSent       Boolean   @default(false)
  discordSent    Boolean   @default(false)
  isRead         Boolean   @default(false)
  screenshotPath String?
  sentAt         DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct? @relation(fields: [storeProductId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("alerts")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  platform  String   @default("web")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  url       String?
  imageUrl  String?
  isRead    Boolean  @default(false)
  type      String   @default("stock_alert")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model ScraperLog {
  id          String   @id @default(cuid())
  storeSlug   String
  productSlug String
  status      String
  message     String?
  duration    Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("scraper_logs")
}

model Comment {
  id        String   @id @default(cuid())
  productId String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("comments")
}

model StockEvent {
  id             String   @id @default(cuid())
  productId      String
  storeProductId String
  storeName      String
  storeSlug      String
  productName    String
  status         String
  price          Float?
  productUrl     String?
  createdAt      DateTime @default(now())

  @@index([productId, createdAt(sort: Desc)])
  @@map("stock_events")
}

// Audit trail for AutoBuy. AutoBuy execution is still a stub, but every time the
// conditions are evaluated for an enabled user we record it here — so the moment
// AutoBuy ever moves money, there's already a money-adjacent paper trail.
model AutoBuyAttempt {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  storeSlug  String
  storeName  String?
  productUrl String?
  price      Float?
  maxPrice   Float?
  outcome    String   // TRIGGERED | SKIPPED_OVER_MAX
  message    String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("autobuy_attempts")
}

enum Role {
  USER
  ADMIN
}

enum AlertType {
  IN_STOCK
  PRICE_DROP
  BACK_IN_STOCK
  OUT_OF_STOCK
  LOW_STOCK
  PICKUP
  PRICE_TARGET
}
