# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://trackit:trackit_pass@localhost:5432/trackit_db"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://:trackit_redis_pass@localhost:6379"

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-at-least-64-chars"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret-at-least-64-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="mailto:admin@trackit.io"

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="TrackIt <noreply@trackit.io>"

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15551234567"

# ─── Scraper ──────────────────────────────────────────────────────────────────
SCRAPER_INTERVAL_MINUTES=5
SCRAPER_CONCURRENCY=5
# Minimum ms between requests to the SAME retailer (per-store pacing); 0 disables
SCRAPER_MIN_INTERVAL_MS=1200
PROXY_URL=""
