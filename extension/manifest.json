{
  "manifest_version": 3,
  "name": "Trackit — Track this item",
  "version": "1.1.0",
  "description": "Send the current retailer product page to your Trackit instance with one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Track this item",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.bestbuy.com/*",
        "*://*.walmart.com/*",
        "*://*.target.com/*",
        "*://*.costco.com/*",
        "*://*.gamestop.com/*",
        "*://*.newegg.com/*",
        "*://*.bhphotovideo.com/*",
        "*://*.adorama.com/*",
        "*://*.microcenter.com/*",
        "*://*.ebay.com/*",
        "*://*.microsoft.com/*",
        "*://*.nintendo.com/*",
        "*://*.apple.com/*",
        "*://*.dell.com/*",
        "*://*.lenovo.com/*",
        "*://*.homedepot.com/*",
        "*://*.lego.com/*",
        "*://*.staples.com/*",
        "*://*.samsclub.com/*",
        "*://*.stockx.com/*",
        "*://*.toysrus.com/*",
        "*://*.kohls.com/*",
        "*://*.officedepot.com/*",
        "*://*.meijer.com/*",
        "*://*.walgreens.com/*",
        "*://*.cvs.com/*",
        "*://*.bjs.com/*",
        "*://*.antonline.com/*",
        "*://*.popmart.com/*",
        "*://*.play-asia.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "trackit-extension@local",
      "strict_min_version": "115.0"
    }
  }
}
