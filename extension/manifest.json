{
  "manifest_version": 3,
  "name": "Trackit — Track this item",
  "version": "1.0.0",
  "description": "Send the current retailer product page to your Trackit instance with one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Track this item",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "trackit-extension@local",
      "strict_min_version": "115.0"
    }
  }
}
